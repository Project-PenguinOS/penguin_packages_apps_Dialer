<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/my_card_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

  <QuickContactBadge
      android:id="@+id/my_card_photo"
      android:layout_width="56dp"
      android:layout_height="56dp"
      android:clickable="false"
      android:forceDarkAllowed="false"/>

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="14dp"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/my_card_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/Dialer.TextAppearance.Hig.Title3"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/my_card_label"
        android:textAppearance="@style/Dialer.TextAppearance.Hig.Subheadline"/>
  </LinearLayout>
</LinearLayout>
