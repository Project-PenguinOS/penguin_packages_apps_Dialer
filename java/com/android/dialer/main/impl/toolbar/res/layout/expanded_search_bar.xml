<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_box_expanded"
    android:layout_width="match_parent"
    android:layout_height="@dimen/collapsed_search_bar_height"
    android:visibility="invisible">

  <ImageButton
      android:id="@+id/search_back_button"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_centerVertical="true"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/action_menu_back_from_search"
      android:src="@drawable/ic_nav_back_chevron"
      app:tint="@color/dialer_tint" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="44dp"
      android:layout_toEndOf="@+id/search_back_button"
      android:layout_centerVertical="true"
      android:layout_marginEnd="8dp"
      android:background="@drawable/search_field_background"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="12dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/quantum_ic_search_vd_theme_24"
        app:tint="@color/dialer_label_secondary" />

    <EditText
        android:forceDarkAllowed="false"
        android:id="@+id/search_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:background="@null"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:imeOptions="flagNoExtractUi"
        android:inputType="textFilter"
        android:maxLines="1"
        android:hint="@string/dialer_hint_find_contact"
        android:textColor="@color/dialer_label_primary"
        android:textColorHint="@color/dialer_label_secondary"
        android:textCursorDrawable="@drawable/custom_cursor"
        android:textSize="17sp"/>

    <ImageView
        android:id="@+id/search_clear_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/description_clear_search"
        android:src="@drawable/quantum_ic_close_vd_theme_24"
        android:visibility="gone"
        app:tint="@color/dialer_label_secondary" />
  </LinearLayout>
</RelativeLayout>
