<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <!-- MainToolbar -->
  <include
      android:id="@+id/toolbar"
      layout="@layout/toolbar_layout"/>

  <androidx.coordinatorlayout.widget.CoordinatorLayout
      android:id="@+id/coordinator_layout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_below="@+id/toolbar">
      <!--android:layout_above="@+id/bottom_nav_bar"-->

    <!-- Holds SpeedDial, Call Log, Contacts, Voicemail and Search fragments -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <FrameLayout
        android:id="@+id/search_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <!--
    android:layout_gravity="end|bottom"
    android:layout_margin="24dp"
    android:layout_marginBottom="20dp"
    -->

    <include android:id="@+id/promotion_bottom_sheet"
        layout="@layout/promotion_bottom_sheet"/>

    <!-- BottomNavBar
    app:layout_anchor="@id/bottom_nav_bar"
    app:layout_anchorGravity="top|end"-->



    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/bottom_nav_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom|center_horizontal"
        android:elevation="8dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="72dp"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"/>





    <ImageButton
        android:id="@+id/search_background_main"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        app:layout_anchor="@id/bottom_nav_bar"
        android:background="@drawable/icon_background_circle"
        android:translationX="12dp"
        android:elevation="4dp"
        android:visibility="gone"
        android:tint="@color/dialer_fab_icon_color"
        app:tint="@color/dialer_fab_icon_color"
        app:backgroundTint="@color/theme_ved_white"
        app:layout_anchorGravity="right"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"  />

    <ImageButton
        android:id="@+id/search_magnifying_glass_main"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        app:layout_anchor="@id/bottom_nav_bar"
        android:elevation="4dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:importantForAccessibility="no"
        android:visibility="gone"
        android:background="@null"
        android:scaleType="center"
        app:layout_anchorGravity="right"
        android:src="@drawable/quantum_ic_search_vd_theme_24"
        android:translationX="12dp"
        android:tint="@color/dialer_fab_icon_color"
        app:tint="@color/dialer_fab_icon_color"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"  />

  </androidx.coordinatorlayout.widget.CoordinatorLayout>

  <!-- Holds Dialpad fragment -->
  <FrameLayout
      android:id="@+id/dialpad_fragment_container"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:elevation="0dp"/>

  <!-- TODO(calderwoodra): investigate what this is for and why we want it. -->
  <!-- Host container for the contact tile drag shadow -->
  <FrameLayout
      android:id="@+id/activity_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent">
    <ImageView
        android:id="@+id/contact_tile_drag_shadow_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:visibility="gone"/>
  </FrameLayout>


</RelativeLayout>
