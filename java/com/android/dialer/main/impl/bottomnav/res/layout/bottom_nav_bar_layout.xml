<com.android.dialer.main.impl.bottomnav.BottomNavBar
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/bottom_nav_bar"
  android:orientation="horizontal"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:background="@drawable/bottom_nav_background_glass">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <include
      android:id="@+id/speed_dial_tab"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="0"
      android:visibility="gone"
      layout="@layout/bottom_nav_item"/>

    <include
      android:id="@+id/call_log_tab"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      layout="@layout/bottom_nav_item"/>

    <include
      android:id="@+id/contacts_tab"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      layout="@layout/bottom_nav_item"/>

    <include
      android:id="@+id/voicemail_tab"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="0"
      android:visibility="gone"
      layout="@layout/bottom_nav_item"/>

    <LinearLayout
      android:id="@+id/keypad_tab"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:minHeight="@dimen/bottom_nav_min_touch_height"
      android:layout_weight="1"
      android:clickable="true"
      android:focusable="true"
      android:contentDescription="@string/dialpad_button_content_description"
      android:gravity="center"
      android:orientation="vertical"
      android:paddingTop="@dimen/bottom_nav_item_padding_vertical"
      android:paddingBottom="@dimen/bottom_nav_item_padding_vertical">

      <com.android.dialer.widget.DialerFloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:duplicateParentState="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:contentDescription="@string/dialpad_button_content_description"
        android:forceDarkAllowed="false"
        android:src="@drawable/veddialer"
        android:stateListAnimator="@null"
        app:backgroundTint="@android:color/transparent"
        app:borderWidth="0dp"
        app:elevation="0dp"
        app:fabCustomSize="@dimen/bottom_nav_icon_size"
        app:maxImageSize="@dimen/bottom_nav_icon_size"
        app:hoveredFocusedTranslationZ="0dp"
        app:pressedTranslationZ="0dp"
        app:tint="@color/dialer_label_primary" />

      <TextView
        android:id="@+id/fab_label"
        style="@style/Dialer.BottomNavLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="@string/dialpad_button_content_description"
        android:textColor="@color/dialer_label_primary"/>

      </LinearLayout>

    </LinearLayout>

  </com.android.dialer.main.impl.bottomnav.BottomNavBar>
