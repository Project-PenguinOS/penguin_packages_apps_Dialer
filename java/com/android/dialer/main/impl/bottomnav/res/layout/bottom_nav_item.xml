<com.android.dialer.main.impl.bottomnav.BottomNavItem
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:minHeight="@dimen/bottom_nav_min_touch_height">

  <FrameLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minWidth="@dimen/bottom_nav_item_min_width">

    <View
        android:id="@+id/active_indicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bottom_nav_selected_capsule"/>

    <LinearLayout
        android:id="@+id/bottom_nav_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/bottom_nav_item_padding_vertical"
        android:paddingBottom="@dimen/bottom_nav_item_padding_vertical"
        android:paddingStart="@dimen/bottom_nav_item_padding_horizontal"
        android:paddingEnd="@dimen/bottom_nav_item_padding_horizontal">

      <FrameLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/bottom_nav_item_image"
            android:layout_width="@dimen/bottom_nav_icon_size"
            android:layout_height="@dimen/bottom_nav_icon_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/quantum_ic_star_vd_theme_24"/>

        <TextView
            android:id="@+id/notification_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:minHeight="18dp"
            android:minWidth="18dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:background="@drawable/notification_badge"
            android:fontFamily="@*android:string/config_headlineFontFamilyMedium"
            android:visibility="invisible"/>
      </FrameLayout>

      <TextView
          android:id="@+id/bottom_nav_item_text"
          style="@style/Dialer.BottomNavLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:importantForAccessibility="no"
          tools:text="Recents"/>
    </LinearLayout>
  </FrameLayout>
</com.android.dialer.main.impl.bottomnav.BottomNavItem>
